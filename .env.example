# ComicCraft Environment Configuration

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Token for Stable Diffusion (Get free token from https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key_here

# Model Configurations
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
SD_MODEL_ID=runwayml/stable-diffusion-v1-5

# Server Configuration
HOST=127.0.0.1
PORT=8000
